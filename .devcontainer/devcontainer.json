{
    "name": "RayTracer",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // Run as the non-root vscode user, remapped to your WSL / Linux user's UID so files
    // created in the container (renders, build output) are owned by you on the host
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,

    // Claude Code CLI and VS Code extension (the CLI needs Node)
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },

    // Claude Code's login and settings persist on a named volume across rebuilds.
    // CLAUDE_CONFIG_DIR keeps ~/.claude.json in there too, not just ~/.claude/.
    // To log out of every container: docker volume rm raytracer-claude-config
    "mounts": [
        "source=raytracer-claude-config,target=/home/vscode/.claude,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },

    // Makes sure the volume is writable, then installs numpy, PyYAML and Pillow plus the
    // `raytracer` command (editable, so code changes apply immediately)
    "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && pip install -e ./python && mkdir -p images build",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-vscode.cpptools",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.unittestEnabled": true,
                "python.testing.pytestEnabled": false,
                "python.testing.cwd": "${workspaceFolder}/python",
                "python.testing.unittestArgs": ["-s", "tests", "-t", "."],
                "C_Cpp.default.compilerPath": "/usr/bin/g++",
                "C_Cpp.default.cppStandard": "c++17",
                "C_Cpp.default.includePath": ["${workspaceFolder}/src"],
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.egg-info": true
                }
            }
        }
    }
}
