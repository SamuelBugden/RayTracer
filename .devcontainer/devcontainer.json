{
    "name": "RayTracer",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // Run as the non-root vscode user, remapped to your WSL / Linux user's UID so files
    // created in the container (renders, build output) are owned by you on the host
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,

    // Installs numpy, PyYAML and Pillow, plus the `raytracer` command (editable, so code changes apply immediately)
    "postCreateCommand": "pip install -e ./python && mkdir -p images build",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-vscode.cpptools",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.unittestEnabled": true,
                "python.testing.pytestEnabled": false,
                "python.testing.cwd": "${workspaceFolder}/python",
                "python.testing.unittestArgs": ["-s", "tests", "-t", "."],
                "C_Cpp.default.compilerPath": "/usr/bin/g++",
                "C_Cpp.default.cppStandard": "c++17",
                "C_Cpp.default.includePath": ["${workspaceFolder}/src"],
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.egg-info": true
                }
            }
        }
    }
}
